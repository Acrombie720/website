---
// The same footer build/build.mjs renders on every other page: logo row, rule,
// then Menu / Insights / Docs / Address / Socials. Kept in step by reading the
// same nav lists from site.config.mjs rather than restating them here.
import { site, menuNav, insightsNav } from '../../../build/site.config.mjs';

type Link = { url: string; label: string };
const insights: Link[] = [...insightsNav, { url: '/blog', label: 'Blog' }];
---
<footer class="ff-foot">
  <div class="ff-foot-top">
    <a href="/" class="ff-foot-logo"><img src={site.wordmark} alt={site.name} width="208" height="44" /></a>
    <a class="ff-foot-cta" href={site.demoUrl} target="_blank" rel="noopener">Book a Demo</a>
  </div>
  <div class="ff-foot-divider"></div>
  <div class="ff-foot-cols">
    <div>
      <h2>Menu</h2>
      {menuNav.map((l: Link) => <a href={l.url}>{l.label}</a>)}
    </div>

    <div>
      <h2>Insights</h2>
      {insights.map((l: Link) => <a href={l.url}>{l.label}</a>)}
    </div>

    <div>
      <h2>Docs</h2>
      <a href="/privacy">Privacy Policy</a>
      <a href="/terms">Terms &amp; Conditions</a>
    </div>

    <div>
      <h2>Address</h2>
      <p set:html={site.address}></p>
    </div>

    <div>
      <h2>Socials</h2>
      <div class="ff-foot-socials">
        <a href={site.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" fill="#5474a1"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.14 1.45-2.14 2.94v5.66H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>
