{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip
	header {
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	@assets path *.css *.js *.webp *.png *.mp4
	header @assets Cache-Control "public, max-age=3600"
	file_server
}
